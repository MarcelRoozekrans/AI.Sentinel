<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sentinel</ToolCommandName>
    <PackageId>AI.Sentinel.Cli</PackageId>
    <Description>Offline replay CLI for AI.Sentinel — run the detector pipeline against saved conversations, browse the local audit file with 'sentinel dashboard', and build a compliance report from it with 'sentinel report'. The dashboard command needs the ASP.NET Core runtime, which the .NET SDK includes.</Description>
    <Version>0.1.0</Version>
    <Authors>Marcel Roozekrans</Authors>
    <PackageTags>ai;security;chatclient;cli;forensics;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/MarcelRoozekrans/AI.Sentinel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);NU5104</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AI.Sentinel.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\AI.Sentinel\AI.Sentinel.csproj" />
    <ProjectReference Include="..\AI.Sentinel.AspNetCore\AI.Sentinel.AspNetCore.csproj" />
    <ProjectReference Include="..\AI.Sentinel.Sqlite\AI.Sentinel.Sqlite.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
  </ItemGroup>
</Project>
