<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <!-- Required by the LibraryImport generator for the libc setsid and getsid imports; the project writes no unsafe code itself. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>AI.Sentinel.ClaudeCode</PackageId>
    <Description>Claude Code hook adapter for AI.Sentinel — scan UserPromptSubmit, PreToolUse, and PostToolUse hook payloads through the detector pipeline.</Description>
    <Version>0.1.0</Version>
    <Authors>Marcel Roozekrans</Authors>
    <PackageTags>ai;security;chatclient;claude-code;hooks</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/MarcelRoozekrans/AI.Sentinel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AI.Sentinel\AI.Sentinel.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <!-- The local Rego policy (SENTINEL_HOOK_POLICY_DIR) runs a WebAssembly module through Wasmtime and an own host of the
         OPA wasm ABI, see docs/plans/2026-11-22-rego-aot-spike.md. Only the untyped Wasmtime API is used: the generic
         wrappers give AOT warnings. -->
    <PackageReference Include="Wasmtime" Version="48.0.2" />
  </ItemGroup>
  <!-- The interop compiler ships an x64 assembly and native library for linux-x64 and win-x64 only. A library is built
       without a runtime identifier, so the tools that publish for another one pass UseInteropCompiler=false when they
       reference this project (AdditionalProperties). The code then leaves the interop compiler out, and the compiler that
       is left is the opa binary. The package stays referenced either way: NuGet restores a library once, and its assets
       only reach a RID that has them. -->
  <PropertyGroup Condition="'$(UseInteropCompiler)' != 'false'">
    <DefineConstants>$(DefineConstants);INTEROP_COMPILER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpaDotNet.Compilation.Interop" Version="2.3.4" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Policy\Rego\capabilities.json" LogicalName="AI.Sentinel.ClaudeCode.Policy.Rego.capabilities.json" />
  </ItemGroup>
</Project>
