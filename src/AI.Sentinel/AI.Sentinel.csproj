<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <!-- CS0168: generated proxy emits a try/catch with _ex when [Count]/[Histogram] are used without [Trace] -->
    <NoWarn>$(NoWarn);CS0168</NoWarn>
    <PackageId>AI.Sentinel</PackageId>
    <Description>Security monitoring middleware for IChatClient — prompt injection, hallucination, and operational anomaly detection with an intervention engine.</Description>
    <Version>0.1.0</Version>
    <Authors>Marcel Roozekrans</Authors>
    <PackageTags>ai;security;chatclient;monitoring;prompt-injection;hallucination</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/MarcelRoozekrans/AI.Sentinel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- The CLIs publish with native AOT; this runs the trim and AOT analyzers on every build, not only at publish. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.1" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.15" />
    <PackageReference Include="ZeroAlloc.AsyncEvents" Version="2.0.1" />
    <PackageReference Include="ZeroAlloc.Results" Version="2.0.0" />
    <PackageReference Include="ZeroAlloc.ValueObjects" Version="2.4.1" />
    <PackageReference Include="ZeroAlloc.Validation" Version="2.6.1" />
    <PackageReference Include="ZeroAlloc.Mediator" Version="6.7.2" />
    <PackageReference Include="ZeroAlloc.Inject" Version="1.12.1" />
    <PackageReference Include="ZeroAlloc.Inject.Generator" Version="1.12.1" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="ZeroAlloc.Resilience" Version="4.0.0" />
    <PackageReference Include="ZeroAlloc.Serialisation" Version="3.0.0" />
    <PackageReference Include="ZeroAlloc.Telemetry" Version="2.0.0" />
    <PackageReference Include="ZeroAlloc.Authorization" Version="3.0.1" />
  </ItemGroup>
</Project>
