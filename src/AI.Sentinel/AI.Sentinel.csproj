<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <!-- CS0168: generated proxy emits a try/catch with _ex when [Count]/[Histogram] are used without [Trace] -->
    <NoWarn>$(NoWarn);CS0168</NoWarn>
    <!-- A library must not ship the public generated registration: apps with their own policies would get CS0121 on AddZeroAllocAuthorization (issue #493) -->
    <ZeroAllocAuthorizationRegistration>internal</ZeroAllocAuthorizationRegistration>
    <PackageId>AI.Sentinel</PackageId>
    <Description>Security monitoring middleware for IChatClient — prompt injection, hallucination, and operational anomaly detection with an intervention engine.</Description>
    <Version>0.1.0</Version>
    <Authors>Marcel Roozekrans</Authors>
    <PackageTags>ai;security;chatclient;monitoring;prompt-injection;hallucination</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/MarcelRoozekrans/AI.Sentinel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- The CLIs publish with native AOT; this runs the trim and AOT analyzers on every build, not only at publish. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.14" />
    <PackageReference Include="ZeroAlloc.AsyncEvents" Version="1.1.11" />
    <PackageReference Include="ZeroAlloc.Collections" Version="1.2.4" />
    <PackageReference Include="ZeroAlloc.Results" Version="1.4.5" />
    <PackageReference Include="ZeroAlloc.ValueObjects" Version="2.3.0" />
    <PackageReference Include="ZeroAlloc.Validation" Version="2.3.5" />
    <PackageReference Include="ZeroAlloc.Mediator" Version="6.6.5" />
    <PackageReference Include="ZeroAlloc.Inject" Version="1.11.6" />
    <PackageReference Include="ZeroAlloc.Inject.Generator" Version="1.11.6" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="ZeroAlloc.Resilience" Version="3.4.0" />
    <PackageReference Include="ZeroAlloc.Serialisation" Version="2.9.0" />
    <PackageReference Include="ZeroAlloc.Telemetry" Version="1.12.6" />
    <PackageReference Include="ZeroAlloc.Authorization" Version="2.2.0" />
  </ItemGroup>
</Project>
