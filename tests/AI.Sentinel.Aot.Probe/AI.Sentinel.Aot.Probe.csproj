<Project Sdk="Microsoft.NET.Sdk">
  <!-- Native AOT probe for DetectorRegistrationTrimTests. Not a test project: the test publishes
       it and reads the ILC warnings. It roots AddAISentinel and AddDetector<T> only. -->
  <PropertyGroup>
    <!-- Clears the net8.0;net10.0 list from Directory.Build.props: publish needs one framework. -->
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <IsPackable>false</IsPackable>
    <!-- Not a test app: keep `dotnet test` from running it. The coverage package from
         tests/Directory.Build.props would otherwise mark it as a Testing Platform application. -->
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AI.Sentinel\AI.Sentinel.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="[10.0.14]" />
  </ItemGroup>
</Project>
