<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <RollForward>LatestMajor</RollForward>
    <!-- xUnit1030: ConfigureAwait(false) forbidden in test methods -->
    <NoWarn>$(NoWarn);MA0004</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AI.Sentinel.OpenTelemetry\AI.Sentinel.OpenTelemetry.csproj" />
    <PackageReference Include="OpenTelemetry" Version="1.19.*" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.*" />
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" Version="1.19.*" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
</Project>
