<Project Sdk="Microsoft.NET.Sdk">
  <!-- Child process that compiles a policy folder with the OpaDotNet interop compiler. The compiler is a Go library, and a
       Go runtime loaded into the test host crashes tests that run later (the tiered JIT of the host and the Go signal
       handlers do not get on), so the tests compile here and load the result from the cache. AI.Sentinel.Tests references
       it, so its output lands next to the test assembly and the tests run it with `dotnet exec`. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Not a test app: keep `dotnet test` from running it. -->
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <RollForward>LatestMajor</RollForward>
    <RootNamespace>AI.Sentinel.Tests.RegoCompiler</RootNamespace>
    <!-- A console app has no SynchronizationContext to capture. -->
    <NoWarn>$(NoWarn);MA0004</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AI.Sentinel.ClaudeCode\AI.Sentinel.ClaudeCode.csproj" />
  </ItemGroup>
</Project>
