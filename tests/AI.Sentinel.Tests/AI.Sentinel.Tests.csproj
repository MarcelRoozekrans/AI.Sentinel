<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <RollForward>LatestMajor</RollForward>
    <!-- In xUnit test projects, ConfigureAwait(false) is forbidden by xUnit1030; suppress MA0004 here -->
    <NoWarn>$(NoWarn);MA0004</NoWarn>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>
  <!-- The three hook/MCP CLIs target net10.0 only (RID-specific .NET 10 tool packages, eng/NativeTool.props).
       The net8.0 leg keeps testing the libraries and skips the tests that use CLI types. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <ProjectReference Include="..\..\src\AI.Sentinel.ClaudeCode.Cli\AI.Sentinel.ClaudeCode.Cli.csproj" />
    <ProjectReference Include="..\..\src\AI.Sentinel.Copilot.Cli\AI.Sentinel.Copilot.Cli.csproj" />
    <ProjectReference Include="..\..\src\AI.Sentinel.Mcp.Cli\AI.Sentinel.Mcp.Cli.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <Compile Remove="Mcp\McpAuditTests.cs" />
    <Compile Remove="Mcp\McpCliTests.cs" />
    <Compile Remove="Mcp\ResourceReadInterceptorTests.cs" />
    <Compile Remove="Mcp\CliSeverityFlagsTests.cs" />
    <Compile Remove="Copilot\CopilotHookCliTests.cs" />
    <Compile Remove="Copilot\CopilotHookCliFailClosedTests.cs" />
    <Compile Remove="Copilot\CopilotHookCliAuditTests.cs" />
    <Compile Remove="ClaudeCode\HookCliTests.cs" />
    <Compile Remove="ClaudeCode\HookCliFailClosedTests.cs" />
    <Compile Remove="ClaudeCode\HookWireFormatTests.cs" />
    <Compile Remove="ClaudeCode\HookCliAuditTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AI.Sentinel\AI.Sentinel.csproj" />
    <ProjectReference Include="..\..\src\AI.Sentinel.Approvals.EntraPim\AI.Sentinel.Approvals.EntraPim.csproj" />
    <ProjectReference Include="..\..\src\AI.Sentinel.Approvals.Sqlite\AI.Sentinel.Approvals.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\AI.Sentinel.AspNetCore\AI.Sentinel.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\AI.Sentinel.Cli\AI.Sentinel.Cli.csproj" />
    <ProjectReference Include="..\..\src\AI.Sentinel.ClaudeCode\AI.Sentinel.ClaudeCode.csproj" />
    <ProjectReference Include="..\..\src\AI.Sentinel.Copilot\AI.Sentinel.Copilot.csproj" />
    <ProjectReference Include="..\..\src\AI.Sentinel.Mcp\AI.Sentinel.Mcp.csproj" />
    <ProjectReference Include="..\AI.Sentinel.Tests.NdjsonWriter\AI.Sentinel.Tests.NdjsonWriter.csproj" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="ZeroAlloc.Serialisation" Version="[2.10.0]" />
    <PackageReference Include="ZeroAlloc.Serialisation.SystemTextJson" Version="[2.10.0]" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="8.0.33" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Fixtures\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
