<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RegoAot</RootNamespace>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <!-- The policy and inputs are read from disk at run time, next to the executable. -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Wasmtime" Version="48.0.2" />
    <PackageReference Include="Rego" Version="1.5.1" />
  </ItemGroup>
  <!-- The interop compiler ships an x64 assembly and native library for linux-x64 and win-x64 only. On any
       other RID the reference fails with CS8012, so it is left out there and the compiler reports itself
       unavailable. A build without a RID, as for a local run on x64, keeps it. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'linux-x64' Or '$(RuntimeIdentifier)' == 'win-x64'">
    <UseInteropCompiler>true</UseInteropCompiler>
    <DefineConstants>$(DefineConstants);INTEROP_COMPILER</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseInteropCompiler)' == 'true'">
    <PackageReference Include="OpaDotNet.Compilation.Interop" Version="2.3.4" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="policy\**\*.rego;policy-unsafe\**\*.rego;inputs\*.json;capabilities.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
