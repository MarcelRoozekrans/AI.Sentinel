<Project>
  <!-- The spike is a throwaway measurement app outside AI.Sentinel.slnx. The repo-root props target
       net10.0 and net11.0 and load the product analyzer set, which this code does not follow, so the
       spike stops the inheritance here. Warnings stay errors, including AOT and trim warnings. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>true</NuGetAudit>
  </PropertyGroup>
</Project>
