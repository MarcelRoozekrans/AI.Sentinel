<Project>
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
    <RootNamespace>AI.Sentinel</RootNamespace>
    <!-- EPS06/EPC12 fire exclusively in source-generator output (*.g.cs); suppress globally -->
    <NoWarn>$(NoWarn);EPS06;EPC12</NoWarn>
    <!-- The System.Text.Json source generator of the .NET 11 SDK emits code that passes Nullable values by value,
         which ErrorProne.NET.Structs reports as EPS05 (error). The code is machine-generated and cannot be edited, and an
         .editorconfig section for *.g.cs does not reach it. The net8.0 and net10.0 builds of the same sources keep the rule. -->
    <NoWarn Condition="'$(TargetFramework)' == 'net11.0'">$(NoWarn);EPS05</NoWarn>
    <!-- Every project that references AI.Sentinel gets the ZeroAlloc.Authorization generator transitively.
         A shipped package must not export the generated registration: an app with its own policies would
         see two public AddZeroAllocAuthorization extensions and get CS0121 (issues #493, #512). -->
    <ZeroAllocAuthorizationRegistration>internal</ZeroAllocAuthorizationRegistration>
  </PropertyGroup>

  <!-- Shared NuGet packaging metadata. Per-package csproj sets PackageId/Description/PackageTags. -->
  <PropertyGroup>
    <PackageIcon>logo.png</PackageIcon>
    <PackageProjectUrl>https://github.com/MarcelRoozekrans/AI.Sentinel</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)assets\logo.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer" Version="[3.0.340]">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Analyzers" Version="[5.0.1]">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ErrorProne.NET.CoreAnalyzers" Version="[0.1.2]">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ErrorProne.NET.Structs" Version="[0.1.2]">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ZeroAlloc.Analyzers" Version="[1.13.0]">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
