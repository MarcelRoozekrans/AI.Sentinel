<Project>
  <!-- Shared by sentinel-hook, sentinel-copilot-hook and sentinel-mcp: RID-specific .NET 10 tool packages.
       `dotnet pack` produces the pointer package, `dotnet pack -r <rid>` the Native AOT package for one RID
       (on a runner of that OS), and `dotnet pack -r any -p:PublishAot=false` the framework-dependent fallback.
       The release pushes every RID package before the pointer, see .github/workflows/release-please.yml. -->
  <PropertyGroup>
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <!-- SDK 11 packs the RID packages it can build on this host together with the pointer when `dotnet pack` runs without -r,
         and restore has no assets for that RID. The release builds each RID package on its own runner with -r, so a pack
         without a RuntimeIdentifier only makes the pointer, as it did on SDK 10. -->
    <CreateRidSpecificToolPackages Condition="'$(RuntimeIdentifier)' == '' and '$(CreateRidSpecificToolPackages)' == ''">false</CreateRidSpecificToolPackages>
    <PublishAot Condition="'$(PublishAot)' == ''">true</PublishAot>
    <!-- musl needs its own packages: the RID graph sends linux-musl-x64 to linux-x64 before any,
         and a glibc binary cannot start on Alpine. -->
    <ToolPackageRuntimeIdentifiers>linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-arm64;win-x64;any</ToolPackageRuntimeIdentifiers>
    <!-- The framework-dependent any fallback also starts on a host that only has a newer .NET runtime. -->
    <RollForward>Major</RollForward>
    <InvariantGlobalization Condition="'$(PublishAot)' == 'true'">true</InvariantGlobalization>
  </PropertyGroup>
  <!-- The OpaDotNet interop compiler of the local Rego policy has a native library for linux-x64 and win-x64 only. A tool
       built for another runtime identifier references the shared hook library with UseInteropCompiler=false, which
       leaves that compiler out of the code, see AI.Sentinel.ClaudeCode.csproj. A build without a runtime identifier keeps
       it, so the solution and the tests build one copy of the library. -->
  <PropertyGroup>
    <InteropCompilerRid Condition="'$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'linux-x64' Or '$(RuntimeIdentifier)' == 'win-x64'">true</InteropCompilerRid>
  </PropertyGroup>
</Project>
