<Project>
  <!-- Shared by sentinel-hook, sentinel-copilot-hook and sentinel-mcp: RID-specific .NET 10 tool packages.
       `dotnet pack` produces the pointer package, `dotnet pack -r <rid>` the Native AOT package for one RID
       (on a runner of that OS), and `dotnet pack -r any -p:PublishAot=false` the framework-dependent fallback.
       The release pushes every RID package before the pointer, see .github/workflows/release-please.yml. -->
  <PropertyGroup>
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <PublishAot Condition="'$(PublishAot)' == ''">true</PublishAot>
    <ToolPackageRuntimeIdentifiers>linux-x64;linux-arm64;osx-arm64;win-x64;any</ToolPackageRuntimeIdentifiers>
    <InvariantGlobalization Condition="'$(PublishAot)' == 'true'">true</InvariantGlobalization>
  </PropertyGroup>
</Project>
